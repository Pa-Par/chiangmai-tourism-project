# MySQL settings for the existing database. Do not put a real password in Git.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=chiangmai_torism_db

# Flask settings
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

# Comma-separated, exact origins allowed to call Flask APIs.
# On Render, retain the Vercel URL below; do not use a wildcard (*).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://chiangmai-tourism-project-flame.vercel.app

# Server-only AI and road-routing integrations. Keep real values only in .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=5
# When Gemini is temporarily unavailable, use the rule-based plan immediately
# for this many seconds before trying Gemini again.
GEMINI_FAILURE_COOLDOWN_SECONDS=60
GOOGLE_MAPS_SERVER_API_KEY=
GOOGLE_MAPS_ROUTES_TIMEOUT_SECONDS=5
